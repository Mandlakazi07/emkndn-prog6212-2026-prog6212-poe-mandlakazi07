@model HomeViewModel
@{
    ViewData["Title"] = "Home";
}

<section class="rd-hero">
    <div class="container">
        <p class="rd-eyebrow">South African road events</p>
        <h1>Race day starts here.</h1>
        <p class="lead">Find your next run, walk or ride. Enter in a minute, and keep every finish.</p>

        @if (User.Identity?.IsAuthenticated != true)
        {
            <a class="btn btn-primary btn-lg me-2" asp-controller="Account" asp-action="Register">Join RaceDay</a>
            <a class="btn btn-outline-light btn-lg" asp-controller="Account" asp-action="Login">Log in</a>
        }
    </div>
</section>

<section class="container rd-section" id="events">
    <h2 class="rd-section-title">Upcoming events</h2>

    <form method="get" asp-controller="Home" asp-action="Index" class="rd-filter-bar">
        <div class="row g-2 align-items-end">
            <div class="col-6 col-md-3">
                <label class="form-label" for="eventType">Type</label>
                <select id="eventType" name="eventType" class="form-select">
                    <option value="">All types</option>
                    <option value="Run" selected="@(Model.EventType == "Run")">Run</option>
                    <option value="Walk" selected="@(Model.EventType == "Walk")">Walk</option>
                    <option value="Cycle" selected="@(Model.EventType == "Cycle")">Cycle</option>
                </select>
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label" for="city">City</label>
                <select id="city" name="city" class="form-select">
                    <option value="">All cities</option>
                    @foreach (var cityName in Model.Cities)
                    {
                        <option value="@cityName" selected="@(Model.City == cityName)">@cityName</option>
                    }
                </select>
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label" for="fromDate">From</label>
                <input id="fromDate" name="fromDate" type="date" class="form-control" value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label" for="toDate">To</label>
                <input id="toDate" name="toDate" type="date" class="form-control" value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-12 col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-fill">Filter</button>
                <a class="btn btn-outline-primary" asp-controller="Home" asp-action="Index">Clear</a>
            </div>
        </div>
    </form>

    @if (Model.ErrorMessage is not null)
    {
        <div class="alert alert-warning">@Model.ErrorMessage</div>
    }
    else if (!Model.Events.Any())
    {
        <p class="text-muted">
            @(Model.HasFilters ? "No events match those filters. Try clearing them." : "No upcoming events yet. Check back soon.")
        </p>
    }
    else
    {
        <div class="row g-4">
            @foreach (var ev in Model.Events)
            {
                var typeClass = "type-" + ev.EventType.ToLowerInvariant();
                <div class="col-md-6 col-lg-4">
                    <article class="card rd-card h-100">
                        @if (!string.IsNullOrEmpty(ev.BannerImageUrl))
                        {
                            <img src="@ev.BannerImageUrl" class="rd-card-img" alt="Banner for @ev.Name" />
                        }
                        else
                        {
                            <div class="rd-card-img rd-card-img-placeholder"><span>@ev.EventType</span></div>
                        }
                        <div class="card-body d-flex flex-column">
                            <span class="type-pill @typeClass align-self-start">@ev.EventType</span>
                            <h3 class="rd-card-title">@ev.Name</h3>
                            <p class="rd-meta">@ev.EventDate.ToString("dd MMM yyyy") | @ev.Venue.City</p>
                            <p class="rd-meta">@ev.Distance.ToString("0.##") km</p>
                            <a class="btn btn-outline-primary btn-sm mt-auto align-self-start" asp-controller="Events"
                               asp-action="Details" asp-route-id="@ev.EventID">View details</a>
                        </div>
                    </article>
                </div>
            }
        </div>
    }
</section>
