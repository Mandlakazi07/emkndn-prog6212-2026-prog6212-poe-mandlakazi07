@model EventsIndexViewModel
@{
    ViewData["Title"] = "My events";
    var today = DateOnly.FromDateTime(DateTime.Today);
}

<div class="rd-page-header">
    <div class="container d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div>
            <h1>My events</h1>
            <p>Create, change and manage your events.</p>
        </div>
        <a class="btn btn-primary" asp-action="Create">Create an event</a>
    </div>
</div>

<div class="container rd-section">
    @if (Model.ErrorMessage is not null)
    {
        <div class="alert alert-warning">@Model.ErrorMessage</div>
    }
    else if (!Model.Events.Any())
    {
        <p class="text-muted">You have not created any events yet.</p>
    }
    else
    {
        <div class="table-responsive rd-table-card">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Event</th>
                        <th>Date</th>
                        <th>Type</th>
                        <th>Venue</th>
                        <th class="text-end">Manage</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ev in Model.Events)
                    {
                        var typeClass = "type-" + ev.EventType.ToLowerInvariant();
                        <tr>
                            <td>
                                <strong>@ev.Name</strong>
                                @if (ev.EventDate < today)
                                {
                                    <span class="badge text-bg-secondary ms-1">Past</span>
                                }
                            </td>
                            <td>@ev.EventDate.ToString("dd MMM yyyy")</td>
                            <td><span class="type-pill @typeClass">@ev.EventType</span></td>
                            <td>@ev.Venue.Name, @ev.Venue.City</td>
                            <td class="text-end text-nowrap">
                                <a class="btn btn-outline-primary btn-sm" asp-action="Edit" asp-route-id="@ev.EventID">Edit</a>
                                <a class="btn btn-outline-primary btn-sm" asp-controller="OrganizerCategories" asp-action="Index" asp-route-eventId="@ev.EventID">Categories</a>
                                <a class="btn btn-outline-primary btn-sm" asp-controller="OrganizerEnrollments" asp-action="Index" asp-route-eventId="@ev.EventID">Enrollments</a>
                                <a class="btn btn-outline-primary btn-sm" asp-controller="OrganizerResults" asp-action="Index" asp-route-eventId="@ev.EventID">Results</a>
                                <form asp-action="Delete" asp-route-id="@ev.EventID" method="post" class="d-inline"
                                      onsubmit="return confirm('Delete this event? This cannot be undone.');">
                                    <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
