@model OrganizerDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="rd-page-header">
    <div class="container">
        <h1>Organizer dashboard</h1>
        <p>Your events, who has entered, and what is coming up.</p>
    </div>
</div>

<div class="container rd-section">
    @if (Model.ErrorMessage is not null)
    {
        <div class="alert alert-warning">@Model.ErrorMessage</div>
    }
    else
    {
        <div class="row g-3 mb-4">
            <div class="col-6 col-lg-3">
                <div class="rd-stat"><span class="rd-stat-number">@Model.TotalEvents</span><span class="rd-stat-label">Events created</span></div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="rd-stat"><span class="rd-stat-number">@Model.UpcomingCount</span><span class="rd-stat-label">Upcoming events</span></div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="rd-stat"><span class="rd-stat-number">@Model.TotalEnrolled</span><span class="rd-stat-label">Participants enrolled</span></div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="rd-stat"><span class="rd-stat-number">@Model.TotalPending</span><span class="rd-stat-label">Waiting for confirmation</span></div>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-lg-8">
                <h2 class="h4 mb-3">Enrolled participants per event</h2>
                @if (!Model.Events.Any())
                {
                    <p class="text-muted">
                        You have not created any events yet.
                        <a asp-controller="OrganizerEvents" asp-action="Create">Create your first event</a>.
                    </p>
                }
                else
                {
                    <div class="table-responsive rd-table-card">
                        <table class="table align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Event</th>
                                    <th>Date</th>
                                    <th class="text-center">Enrolled</th>
                                    <th class="text-center">Confirmed</th>
                                    <th class="text-center">Pending</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Events)
                                {
                                    <tr>
                                        <td><strong>@item.Event.Name</strong></td>
                                        <td>@item.Event.EventDate.ToString("dd MMM yyyy")</td>
                                        <td class="text-center">@item.Enrolled</td>
                                        <td class="text-center">@item.Confirmed</td>
                                        <td class="text-center">@item.Pending</td>
                                        <td class="text-end">
                                            <a class="btn btn-outline-primary btn-sm" asp-controller="OrganizerEnrollments"
                                               asp-action="Index" asp-route-eventId="@item.Event.EventID">Enrollments</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <div class="col-lg-4">
                <h2 class="h4 mb-3">Upcoming dates</h2>
                @if (!Model.Upcoming.Any())
                {
                    <p class="text-muted">Nothing coming up.</p>
                }
                else
                {
                    <ul class="list-unstyled rd-upcoming">
                        @foreach (var item in Model.Upcoming)
                        {
                            <li>
                                <span class="rd-upcoming-date">@item.Event.EventDate.ToString("dd MMM")</span>
                                <span>
                                    <strong>@item.Event.Name</strong><br />
                                    <small class="text-muted">@item.Event.Venue.City | @item.Enrolled enrolled</small>
                                </span>
                            </li>
                        }
                    </ul>
                }
                <a class="btn btn-primary mt-2" asp-controller="OrganizerEvents" asp-action="Create">Create an event</a>
            </div>
        </div>
    }
</div>
