@* A colour-coded enrollment status: green = Confirmed, amber = Pending, red = Cancelled.
   Use it anywhere with: <partial name="_StatusBadge" model="enrollment.Status" /> *@
@model string
@{
    var css = Model switch
    {
        "Confirmed" => "status-confirmed",
        "Pending" => "status-pending",
        "Cancelled" => "status-cancelled",
        _ => "status-unknown"
    };
}
<span class="status-badge @css">@Model</span>
