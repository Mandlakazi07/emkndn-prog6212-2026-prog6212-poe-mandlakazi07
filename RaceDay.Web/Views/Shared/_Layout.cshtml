@*
   Student:     Mandlakazi Sibiya
   Module:      PROG6212 Programming 2B - PoE Part 3
   Institution: The Independent Institute of Education (IIE)
   Date:        3 November 2026
   AI use:      Claude (Anthropic) helped draft and explain this file. Reviewed and understood by the student.
   References:  Bootstrap, n.d. Bootstrap 5.3 documentation. [online] Available at:
                https://getbootstrap.com/docs/5.3/getting-started/introduction/ [Accessed 3 November 2026].
*@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RaceDay</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark rd-navbar">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">RACE<span>DAY</span></a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#rdNav"
                        aria-controls="rdNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="rdNav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Home</a></li>

                        @* Each role gets its own menu items. The pages themselves are protected on the server as well. *@
                        @if (User.IsInRole("Organizer"))
                        {
                            <partial name="_OrganizerMenu" />
                        }
                        @if (User.IsInRole("Participant"))
                        {
                            <partial name="_ParticipantMenu" />
                        }
                    </ul>

                    <ul class="navbar-nav align-items-lg-center">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <span class="navbar-text me-3">
                                    @User.Identity?.Name
                                    <span class="role-pill">@(User.IsInRole("Organizer") ? "Organizer" : "Participant")</span>
                                </span>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-outline-light btn-sm">Log out</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Log in</a></li>
                            <li class="nav-item ms-lg-2">
                                <a class="btn btn-primary btn-sm" asp-controller="Account" asp-action="Register">Join RaceDay</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="rd-main">
        <div class="container pt-3">
            @if (TempData["Success"] is string successMessage)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @successMessage
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["Error"] is string errorMessage)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @errorMessage
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
        </div>

        @RenderBody()
    </main>

    <footer class="rd-footer">
        <div class="container">
            <span>&copy; 2026 RaceDay</span>
            <span class="rd-footer-note">PROG6212 PoE Part 3 | Mandlakazi Sibiya</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

