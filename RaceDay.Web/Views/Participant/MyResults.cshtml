@model MyResultsViewModel
@{
    ViewData["Title"] = "My results";
}

<div class="rd-page-header">
    <div class="container">
        <h1>My results</h1>
        <p>Your race history across every event you have finished.</p>
    </div>
</div>

<div class="container rd-section">
    @if (Model.ErrorMessage is not null)
    {
        <div class="alert alert-warning">@Model.ErrorMessage</div>
    }
    else if (!Model.Results.Any())
    {
        <p class="text-muted">
            No results yet. They appear here once an organizer records your finish.
        </p>
    }
    else
    {
        <div class="table-responsive rd-table-card">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Event</th>
                        <th>Date</th>
                        <th>Category</th>
                        <th>Finish time</th>
                        <th>Position</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var result in Model.Results)
                    {
                        <tr>
                            <td><strong>@result.EventName</strong></td>
                            <td>@result.EventDate.ToString("dd MMM yyyy")</td>
                            <td>@result.CategoryName</td>
                            <td class="rd-time">@result.TimeText()</td>
                            <td><span class="rd-position">@result.PositionText()</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
