@model MyEventsViewModel
@{
    ViewData["Title"] = "My events";
}

<div class="rd-page-header">
    <div class="container">
        <h1>My events</h1>
        <p>Every event you have entered, and where each enrollment stands.</p>
    </div>
</div>

<div class="container rd-section">
    @if (Model.ErrorMessage is not null)
    {
        <div class="alert alert-warning">@Model.ErrorMessage</div>
    }
    else if (!Model.Enrollments.Any())
    {
        <p class="text-muted">
            You have not entered any events yet. <a asp-controller="Home" asp-action="Index">Find an event</a>.
        </p>
    }
    else
    {
        <div class="table-responsive rd-table-card">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Event</th>
                        <th>Date</th>
                        <th>Category</th>
                        <th>Entered on</th>
                        <th>Status</th>
                        <th class="text-end"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var enrollment in Model.Enrollments)
                    {
                        <tr>
                            <td>
                                <a asp-controller="Events" asp-action="Details" asp-route-id="@enrollment.EventID"><strong>@enrollment.EventName</strong></a>
                            </td>
                            <td>@enrollment.EventDate.ToString("dd MMM yyyy")</td>
                            <td>@enrollment.CategoryName</td>
                            <td>@enrollment.EnrollmentDate.ToString("dd MMM yyyy")</td>
                            <td><partial name="_StatusBadge" model="enrollment.Status" /></td>
                            <td class="text-end">
                                <form asp-action="Withdraw" asp-route-id="@enrollment.EnrollmentID" method="post" class="d-inline"
                                      onsubmit="return confirm('Withdraw from this event?');">
                                    <button type="submit" class="btn btn-outline-danger btn-sm">Withdraw</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
