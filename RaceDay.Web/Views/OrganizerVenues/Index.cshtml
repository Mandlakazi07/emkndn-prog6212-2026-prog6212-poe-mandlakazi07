@model VenuesIndexViewModel
@{
    ViewData["Title"] = "Venues";
}

<div class="rd-page-header">
    <div class="container">
        <h1>Venues</h1>
        <p>Every event takes place at a venue. Add the places you use here.</p>
    </div>
</div>

<div class="container rd-section">
    <div class="row g-4">
        <div class="col-lg-5">
            <div class="rd-form-card">
                <h2 class="h4">Add a venue</h2>
                <form asp-action="Create" method="post">
                    <div class="mb-3">
                        <label asp-for="NewVenue.Name" class="form-label"></label>
                        <input asp-for="NewVenue.Name" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label asp-for="NewVenue.Address" class="form-label"></label>
                        <input asp-for="NewVenue.Address" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label asp-for="NewVenue.City" class="form-label"></label>
                        <input asp-for="NewVenue.City" class="form-control" required />
                    </div>
                    <button type="submit" class="btn btn-primary">Add venue</button>
                </form>
            </div>
        </div>

        <div class="col-lg-7">
            <h2 class="h4 mb-3">Venues</h2>
            @if (Model.ErrorMessage is not null)
            {
                <div class="alert alert-warning">@Model.ErrorMessage</div>
            }
            else if (!Model.Venues.Any())
            {
                <p class="text-muted">No venues yet.</p>
            }
            else
            {
                <div class="table-responsive rd-table-card">
                    <table class="table align-middle mb-0">
                        <thead><tr><th>Name</th><th>Address</th><th>City</th></tr></thead>
                        <tbody>
                            @foreach (var venue in Model.Venues)
                            {
                                <tr>
                                    <td><strong>@venue.Name</strong></td>
                                    <td>@venue.Address</td>
                                    <td>@venue.City</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
