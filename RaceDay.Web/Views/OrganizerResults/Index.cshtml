@model EventResultsViewModel
@{
    ViewData["Title"] = "Results";
    var disabledAttribute = Model.EventHasStarted ? "" : "disabled";
}

<div class="rd-page-header">
    <div class="container">
        <h1>Results</h1>
        <p>@Model.Event.Name | @Model.Event.EventDate.ToString("dd MMM yyyy")</p>
    </div>
</div>

<div class="container rd-section">
    @if (!Model.EventHasStarted)
    {
        <div class="alert alert-info">Results can be entered once the event has taken place.</div>
    }

    @if (!Model.Rows.Any())
    {
        <p class="text-muted">Nobody is enrolled in this event, so there is nothing to record.</p>
    }
    else
    {
        <div class="table-responsive rd-table-card">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Participant</th>
                        <th>Category</th>
                        <th>Finish time</th>
                        <th>Position</th>
                        <th class="text-end">Save</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        <tr>
                            <td><strong>@row.Enrollment.ParticipantName</strong></td>
                            <td>@row.Enrollment.CategoryName</td>
                            @if (row.Result is not null)
                            {
                                <td>@(row.Result.FinishTime?.ToString("hh\\:mm\\:ss"))</td>
                                <td>@row.Result.FinishPosition</td>
                                <td class="text-end"><span class="status-badge status-confirmed">Recorded</span></td>
                            }
                            else
                            {
                                <td colspan="3">
                                    <form asp-action="Record" asp-route-eventId="@Model.Event.EventID" method="post"
                                          class="d-flex flex-wrap gap-2 align-items-center">
                                        <input type="hidden" name="EnrollmentID" value="@row.Enrollment.EnrollmentID" />
                                        <input type="text" name="FinishTime" class="form-control form-control-sm rd-input-time"
                                               placeholder="hh:mm:ss" maxlength="8" required disabled="@(!Model.EventHasStarted)" />
                                        <input type="number" name="FinishPosition" class="form-control form-control-sm rd-input-position"
                                               placeholder="Position" min="1" required disabled="@(!Model.EventHasStarted)" />
                                        <button type="submit" class="btn btn-primary btn-sm ms-auto" disabled="@(!Model.EventHasStarted)">Save result</button>
                                    </form>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    <a class="btn btn-outline-primary mt-3" asp-controller="OrganizerEvents" asp-action="Index">Back to my events</a>
</div>
