@model CategoryFormViewModel
@{
    ViewData["Title"] = "Edit category";
}

<div class="rd-page-header">
    <div class="container">
        <h1>Edit category</h1>
        <p>@ViewData["EventName"]</p>
    </div>
</div>

<div class="container rd-section">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="rd-form-card">
                <form asp-action="Edit" asp-route-eventId="@Model.EventID" asp-route-id="@Model.CategoryID" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="mb-3">
                        <label asp-for="CategoryName" class="form-label"></label>
                        <input asp-for="CategoryName" class="form-control" />
                        <span asp-validation-for="CategoryName" class="text-danger"></span>
                    </div>
                    <div class="row">
                        <div class="col-6 mb-3">
                            <label asp-for="MinAge" class="form-label"></label>
                            <input asp-for="MinAge" type="number" min="0" max="120" class="form-control" />
                            <span asp-validation-for="MinAge" class="text-danger"></span>
                        </div>
                        <div class="col-6 mb-3">
                            <label asp-for="MaxAge" class="form-label"></label>
                            <input asp-for="MaxAge" type="number" min="0" max="120" class="form-control" />
                            <span asp-validation-for="MaxAge" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="mb-4">
                        <label asp-for="DistanceKm" class="form-label"></label>
                        <input asp-for="DistanceKm" type="number" step="any" min="0" class="form-control" />
                        <span asp-validation-for="DistanceKm" class="text-danger"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Save changes</button>
                        <a class="btn btn-outline-primary" asp-action="Index" asp-route-eventId="@Model.EventID">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
