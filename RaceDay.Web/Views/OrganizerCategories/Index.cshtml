@model EventCategoriesViewModel
@{
    ViewData["Title"] = "Categories";
}

<div class="rd-page-header">
    <div class="container">
        <h1>Categories</h1>
        <p>@Model.Event.Name | @Model.Event.EventDate.ToString("dd MMM yyyy")</p>
    </div>
</div>

<div class="container rd-section">
    <div class="row g-4">
        <div class="col-lg-5">
            <div class="rd-form-card">
                <h2 class="h4">Add a category</h2>
                <p class="text-muted">The age range and distance are optional.</p>

                <form asp-action="Create" asp-route-eventId="@Model.Event.EventID" method="post">
                    <div class="mb-3">
                        <label asp-for="NewCategory.CategoryName" class="form-label"></label>
                        <input asp-for="NewCategory.CategoryName" class="form-control" placeholder="For example Senior or 10 km" />
                    </div>
                    <div class="row">
                        <div class="col-6 mb-3">
                            <label asp-for="NewCategory.MinAge" class="form-label"></label>
                            <input asp-for="NewCategory.MinAge" type="number" min="0" max="120" class="form-control" />
                        </div>
                        <div class="col-6 mb-3">
                            <label asp-for="NewCategory.MaxAge" class="form-label"></label>
                            <input asp-for="NewCategory.MaxAge" type="number" min="0" max="120" class="form-control" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="NewCategory.DistanceKm" class="form-label"></label>
                        <input asp-for="NewCategory.DistanceKm" type="number" step="any" min="0" class="form-control" />
                    </div>
                    <button type="submit" class="btn btn-primary">Add category</button>
                </form>
            </div>
        </div>

        <div class="col-lg-7">
            <h2 class="h4 mb-3">Categories in this event</h2>
            @if (!Model.Categories.Any())
            {
                <p class="text-muted">No categories yet. Participants need at least one to enter your event.</p>
            }
            else
            {
                <div class="table-responsive rd-table-card">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr><th>Name</th><th>Who and how far</th><th class="text-end">Manage</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var category in Model.Categories)
                            {
                                <tr>
                                    <td><strong>@category.CategoryName</strong></td>
                                    <td>@category.Summary</td>
                                    <td class="text-end text-nowrap">
                                        <a class="btn btn-outline-primary btn-sm" asp-action="Edit"
                                           asp-route-eventId="@Model.Event.EventID" asp-route-id="@category.CategoryID">Edit</a>
                                        <form asp-action="Delete" asp-route-eventId="@Model.Event.EventID" asp-route-id="@category.CategoryID"
                                              method="post" class="d-inline"
                                              onsubmit="return confirm('Delete this category?');">
                                            <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            <a class="btn btn-outline-primary mt-3" asp-controller="OrganizerEvents" asp-action="Index">Back to my events</a>
        </div>
    </div>
</div>
